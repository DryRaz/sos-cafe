# Copy the variables you need into Vercel's Project Settings → Environment
# Variables. Never commit real secrets to this repo — this file only
# documents names and (where safe) Safaricom's public sandbox values.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- M-Pesa (Safaricom Daraja) ---
# "sandbox" for testing (fake money, Safaricom's test shortcode/passkey
# below), "production" once you have a real Till/Paybill and go live.
MPESA_ENV=sandbox

# From your app on https://developer.safaricom.co.ke — different for
# sandbox vs production, generate a new pair when you switch.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox: Safaricom's public test values (safe to use as-is).
# Production: your real Till/Paybill number and its passkey from the
# Daraja portal ("Lipa Na M-Pesa Online" settings for that shortcode).
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till
# (Buy Goods) number. The sandbox only supports CustomerPayBillOnline
# regardless of what your production shortcode will be, so leave this
# unset (it defaults to CustomerPayBillOnline) until you switch to your
# real Till number, then set it to CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Public HTTPS URL Safaricom calls with the payment result. Must be
# reachable from the internet — your production domain, not localhost.
MPESA_CALLBACK_URL=https://sos-caffe.vercel.app/api/mpesa/callback
